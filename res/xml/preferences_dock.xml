<?xml version="1.0" encoding="utf-8"?>
<!-- Migration04 §04: dock screen — see Plans/Migration04/04-settings-ui-modularization.md §6 -->
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:title="@string/dock_category_title">

    <SwitchPreference
        android:key="pref_show_dock"
        android:title="@string/show_dock_title"
        android:summary="@string/show_dock_summary"
        android:defaultValue="true"
        android:persistent="false" />

    <ListPreference
        android:key="pref_dock_icon_count"
        android:title="@string/dock_icon_count_title"
        android:summary="@string/dock_icon_count_summary"
        android:persistent="false" />

    <SwitchPreference
        android:key="pref_dock_labels"
        android:title="@string/dock_labels_title"
        android:summary="@string/dock_labels_summary"
        android:defaultValue="false"
        android:persistent="false" />

    <Preference
        android:key="pref_dock_bg_hex"
        android:title="@string/dock_bg_hex_title"
        android:summary="@string/dock_bg_hex_summary"
        android:persistent="false" />

    <ListPreference
        android:key="pref_dock_bg_color"
        android:title="@string/dock_bg_color_title"
        android:summary="@string/dock_bg_color_summary"
        android:persistent="false" />

    <androidx.preference.SeekBarPreference
        android:key="pref_dock_bg_opacity"
        android:title="@string/dock_bg_opacity_title"
        android:defaultValue="100"
        android:max="100"
        android:persistent="false" />

    <androidx.preference.SeekBarPreference
        android:key="pref_dock_corner_radius"
        android:title="@string/dock_corner_radius_title"
        android:defaultValue="0"
        android:max="50"
        android:persistent="false" />

    <androidx.preference.SeekBarPreference
        android:key="pref_hotseat_bottom_factor"
        android:title="@string/hotseat_bottom_factor_title"
        android:summary="@string/hotseat_bottom_factor_summary"
        android:defaultValue="100"
        android:max="170"
        android:min="0"
        android:persistent="false" />

    <SwitchPreference
        android:key="pref_dock_search_bar"
        android:title="@string/dock_search_bar_title"
        android:summary="@string/dock_search_bar_summary"
        android:defaultValue="true"
        android:persistent="false" />

    <androidx.preference.SeekBarPreference
        android:key="pref_hotseat_inset_left"
        android:title="@string/hotseat_inset_left_title"
        android:defaultValue="0"
        android:max="100"
        android:min="0"
        android:persistent="false" />

    <androidx.preference.SeekBarPreference
        android:key="pref_hotseat_inset_right"
        android:title="@string/hotseat_inset_right_title"
        android:defaultValue="0"
        android:max="100"
        android:min="0"
        android:persistent="false" />

    <androidx.preference.SeekBarPreference
        android:key="pref_hotseat_inset_top"
        android:title="@string/hotseat_inset_top_title"
        android:defaultValue="0"
        android:max="100"
        android:min="0"
        android:persistent="false" />

    <androidx.preference.SeekBarPreference
        android:key="pref_hotseat_inset_bottom"
        android:title="@string/hotseat_inset_bottom_title"
        android:defaultValue="0"
        android:max="100"
        android:min="0"
        android:persistent="false" />

</androidx.preference.PreferenceScreen>
