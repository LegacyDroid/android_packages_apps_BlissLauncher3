// https://repo1.maven.org/maven2/com/jakewharton/timber/timber/5.0.1/timber-5.0.1.aar
android_library_import {
    name: "timber-5.0.1",
    aars:  ["timber-5.0.1.aar"],
}

// https://github.com/getsentry/sentry-java/releases/tag/8.15.1
android_library_import {
    name: "sentry-android-core-release",
    aars:  ["sentry-android-core-release.aar"],
}

// https://github.com/getsentry/sentry-java/releases/tag/8.15.1
android_library_import {
    name: "sentry-android-timber-release",
    aars:  ["sentry-android-timber-release.aar"],
}

// https://github.com/getsentry/sentry-java/releases/tag/8.15.1
android_library_import {
    name: "sentry-android-release",
    aars:  ["sentry-android-release.aar"],
}

// https://gitlab.e.foundation/e/os/e-telemetry
android_library_import {
    name: "e-telemetry",
    aars:  ["telemetry-1.0.0-release.aar"],
}

// https://github.com/getsentry/sentry-java/releases/tag/8.15.1
java_import {
    name: "sentry-8.15.1",
    jars: [
        "sentry-8.15.1.jar",
    ],
}

// https://repo1.maven.org/maven2/com/squareup/okhttp3/okhttp/4.12.0/okhttp-4.12.0.jar
java_import {
    name: "okhttp-4.12.0",
    jars: [
        "okhttp-4.12.0.jar",
    ],
}

// https://repo1.maven.org/maven2/com/squareup/okhttp3/logging-interceptor/4.12.0/logging-interceptor-4.12.0.jar
java_import {
    name: "logging-interceptor-4.12.0",
    jars: [
        "logging-interceptor-4.12.0.jar",
    ],
}

// https://repo1.maven.org/maven2/com/squareup/retrofit2/converter-gson/3.0.0/converter-gson-3.0.0.jar
java_import {
    name: "converter-gson-3.0.0",
    jars: [
        "converter-gson-3.0.0.jar",
    ],
}

// https://repo1.maven.org/maven2/org/jetbrains/kotlinx/kotlinx-coroutines-rx2/1.9.0/kotlinx-coroutines-rx2-1.9.0.jar
java_import {
    name: "kotlinx-coroutines-rx2-1.9.0",
    jars: [
        "kotlinx-coroutines-rx2-1.9.0.jar",
    ],
}

// https://repo1.maven.org/maven2/io/reactivex/rxjava3/rxjava/3.1.10/rxjava-3.1.10.jar
java_import {
    name: "rxjava-3.1.10",
    jars: [
        "rxjava-3.1.10.jar",
    ],
}

// https://repo1.maven.org/maven2/com/squareup/retrofit2/retrofit/2.11.0/retrofit-2.11.0.jar
java_import {
    name: "retrofit-2.11.0",
    jars: [
        "retrofit-2.11.0.jar",
    ],
}

java_library {
    name: "sentry-libs",
    static_libs: [
        "sentry-android-core-release",
        "sentry-android-timber-release",
        "sentry-android-release",
        "sentry-8.15.1",
    ],
    sdk_version: "current",
}

java_library {
    name: "BlissLauncher3-libs",
    static_libs: [
        "timber-5.0.1",
        "e-telemetry",
        "okhttp-4.12.0",
        "logging-interceptor-4.12.0",
        "converter-gson-3.0.0",
        "kotlinx-coroutines-rx2-1.9.0",
        "rxjava-3.1.10",
        "retrofit-2.11.0",
        "sentry-libs",
    ],
    sdk_version: "current",
}
