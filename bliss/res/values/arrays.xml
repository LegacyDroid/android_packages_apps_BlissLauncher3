    </string-array>

    <string-array name="hidden_apps_in_search_entries">
        <item>@string/hidden_apps_in_search_never</item>
        <item>@string/hidden_apps_in_search_always</item>
        <item>@string/hidden_apps_in_search_if_typed</item>
