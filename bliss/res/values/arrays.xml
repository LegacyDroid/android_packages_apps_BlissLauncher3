        <item>never</item>
        <item>always</item>
        <item>if_name_typed</item>
    </string-array>

    <string-array name="dot_text_color_entries">
        <item>@string/dot_text_color_auto</item>
        <item>@string/dot_text_color_white</item>
        <item>@string/dot_text_color_black</item>
    </string-array>
    <string-array name="dot_text_color_values">
        <item>auto</item>
