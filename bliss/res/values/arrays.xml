         "suck_in") and to CloseOverlayMode.prefValue. -->
    <string-array name="closing_overlay_entries">
        <item>@string/overlay_none</item>
        <item>@string/overlay_fade_in</item>
        <item>@string/overlay_suck_in</item>
    </string-array>
    <string-array name="closing_overlay_values">
        <item>none</item>
        <item>fade_in</item>
        <item>suck_in</item>
